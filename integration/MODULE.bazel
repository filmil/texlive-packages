#
# An outside consumer of texlive_packages, resolved from the Bazel Central
# Registry alone: the BCR presubmit runs this module (.bcr/presubmit.yml).
module(
    name = "texlive_packages_integration",
    version = "0.0.0",
)

bazel_dep(name = "texlive_packages", version = "0.0.0")
local_path_override(
    module_name = "texlive_packages",
    path = "..",
)

bazel_dep(name = "rules_shell", version = "0.8.0")
